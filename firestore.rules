rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Chats Collection
    match /chats/{clientPhone} {
      allow read, write: if true;

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
